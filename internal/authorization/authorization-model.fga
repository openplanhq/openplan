model
  schema 1.1

type user

type platform
  relations
    define root: [user]
    define admin: [user]
    define editor: [user]
    define viewer: [user]

    # Tiers. Internal plumbing: the one place the ordering is expressed, so no
    # capability below has to repeat it. Routes do not check these.
    define can_administer: admin or root
    define can_edit: can_administer or editor
    define can_view: can_edit or viewer

    # Capabilities. What routes check. Each one gates a real route; retiring a
    # route retires its capability.
    define can_create_stack: can_edit
    define can_manage_templates: can_edit
    define can_read_template: can_view
    # Granting and revoking platform roles, and the platform-wide person
    # search that picking someone for a role needs.
    define can_manage_platform_access: can_administer

type stack
  relations
    define owner: [user]
    define operator: [user]
    define approver: [user]
    define viewer: [user]
    define parent: [platform]

    # A ladder: viewer < operator < approver < owner. Each rung includes the
    # one below it, so one grant per user is always enough to express a role.
    define can_manage_access: owner or can_administer from parent
    define can_approve: can_manage_access or approver
    define can_operate: can_approve or operator
    define can_view: can_operate or viewer or can_view from parent
