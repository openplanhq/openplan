FROM golang:1.25.14-alpine3.23 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/openplan-api ./cmd/api

FROM alpine:3.21

# git: template sync clones repositories, and it runs in the API's control-plane
# worker.
RUN apk add --no-cache ca-certificates git \
    # Same uid and gid as Dockerfile.executor: the two share the artifacts
    # volume through the group openplan.
    && addgroup -S -g 10001 openplan \
    && adduser -S -D -H -u 10001 -G openplan openplan \
    && mkdir -p /var/lib/openplan/artifacts \
    && chown -R openplan:openplan /var/lib/openplan \
    && chmod 2770 /var/lib/openplan/artifacts
COPY --from=build /out/openplan-api /usr/local/bin/openplan-api

USER openplan
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/openplan-api"]
