set -eu

# This can run straight after vm/'s apply, while its first-boot setup still
# logs gh in and clones the setup repo that the loader below points at. Wait
# for it; how it ended doesn't matter here, as a failed setup fails the clone.
cloud-init status --wait > /dev/null || true

# Kept on a re-run, and on a destroy: the clone may hold unpushed work. A
# folder made by hand is still cloned into.
[ -d "$HOME/projects/github/${repo}/.git" ] || gh repo clone "${repo}" "$HOME/projects/github/${repo}"

# CLAUDE.local.md is gitignored, so a clone doesn't bring the loader that
# points a repo at its entry in the setup repo; write it as project-init does.
if [ -f "$HOME/${entry}" ]; then
  {
    if [ -f "$HOME/projects/github/${repo}/AGENTS.md" ]; then echo '@AGENTS.md'; fi
    echo "@~/${entry}"
  } > "$HOME/projects/github/${repo}/CLAUDE.local.md"
fi

# The service has no terminal for Claude's questions. In an untrusted clone
# Remote Control exits "Workspace not trusted", with "Enable Remote Control?"
# unanswered it hangs without connecting, and a session it spawns drops
# CLAUDE.md imports from outside the repo, the loader's entry above included,
# because loading them waits on a question too. So answer all three the way
# the prompts would: trust and imports per git root, Remote Control once per
# machine. A broken ~/.claude.json fails the apply here, before a service
# waits on it.
claude_json="$HOME/.claude.json"
[ -s "$claude_json" ] || echo '{}' > "$claude_json"
tmp="$(mktemp "$claude_json.XXXXXX")"
jq --arg p "$HOME/projects/github/${repo}" '.remoteDialogSeen = true | .projects[$p].hasTrustDialogAccepted = true | .projects[$p].hasClaudeMdExternalIncludesApproved = true | .projects[$p].hasClaudeMdExternalIncludesWarningShown = true' "$claude_json" > "$tmp"
mv "$tmp" "$claude_json"
# A Claude save that read the file before the mv, or another repo's script
# running alongside, can rename over it and drop the entry. Nothing re-runs
# this script, so fail the apply rather than leave the clone untrusted; the
# next apply replaces the session and writes it again.
sleep 1
jq -e --arg p "$HOME/projects/github/${repo}" '.remoteDialogSeen and .projects[$p].hasTrustDialogAccepted and .projects[$p].hasClaudeMdExternalIncludesApproved' "$claude_json" > /dev/null

# The setup repo's shared settings deny reading .env, and Claude's Edit tool
# reads a file before it changes it, so the deny blocks edits too. Sessions
# here set up a clone's local .env, so this VM drops that one rule; other
# machines keep it. Re-running bootstrap.sh here puts it back until the next
# session replacement. No settings means bootstrap never ran: nothing to drop.
settings="$HOME/.claude/settings.json"
if [ -f "$settings" ]; then
  tmp="$(mktemp "$settings.XXXXXX")"
  jq 'del(.permissions.deny[]? | select(. == "Read(**/.env)"))' "$settings" > "$tmp"
  mv "$tmp" "$settings"
fi

# restart, not start: a changed unit reaches a service that's already running.
unit="claude-rc@$(systemd-escape "${repo}").service"
systemctl --user enable "$unit"
systemctl --user restart "$unit"
