#!/usr/bin/env bash
# The VM's setup as ${user}, run once by cloud-init at first boot, after root's
# part (packages, the docker group, lingering). When a download fails halfway,
# run it again over SSH: gh is logged in by then, and a repo already cloned is
# kept.
set -euo pipefail

# gh keeps the token in its own config, and git asks gh for it, so the file
# that brought it goes whether the login worked or not.
trap 'rm -f "$HOME/.github-token"' EXIT

git config --global user.name '${replace(git_user_name, "'", "'\\''")}'
git config --global user.email '${replace(git_user_email, "'", "'\\''")}'

gh auth status >/dev/null 2>&1 || gh auth login --with-token < "$HOME/.github-token"
gh auth setup-git

# The path the setup repo's instructions use: ~/projects/github/<owner>/<repo>.
# A copy with no .git: the laptop keeps the setup repo's git and makes all its
# commits, and Syncthing keeps this copy in step with it. GitHub's tarball
# gives every file its last commit's time, so where the laptop has a newer
# edit, the first sync keeps the laptop's. Unpacked beside the folder and moved
# in whole, so a re-run after a failed download starts clean. The other repos
# are sessions/', which clones them on the running VM.
repo="$HOME/projects/github/${setup_repository}"
if [ ! -d "$repo" ]; then
  mkdir -p "$(dirname "$repo")"
  tmp="$(mktemp -d "$repo.XXXXXX")"
  gh api "repos/${setup_repository}/tarball" | tar -xz -C "$tmp" --strip-components=1
  chmod 0755 "$tmp"
  mv "$tmp" "$repo"
fi
# The setup repo's own list keeps .git, the beads databases and secrets on the
# machine that has them.
[ -f "$repo/.stignore" ] || printf '#include .stignore-shared\n' > "$repo/.stignore"

# Into ~/.local/bin; it updates itself from then on. cloud-init's PATH lacks
# that folder, and bootstrap.sh below needs claude on it to install the
# plugins and the MCP server.
curl -fsSL https://claude.ai/install.sh | bash
export PATH="$HOME/.local/bin:$PATH"

# A session would otherwise open on the first-run screens, which nobody is
# there to click through. mktemp keeps the file 0600.
claude_json="$HOME/.claude.json"
[ -f "$claude_json" ] || echo '{}' > "$claude_json"
tmp="$(mktemp "$claude_json.XXXXXX")"
jq '.hasCompletedOnboarding = true' "$claude_json" > "$tmp" && mv "$tmp" "$claude_json"

# Above Debian's early return for non-interactive shells, so a command run over
# SSH finds claude in ~/.local/bin too.
line='export PATH="$HOME/.local/bin:$PATH"'
grep -qxF "$line" ~/.bashrc || { printf '%s\n' "$line" | cat - ~/.bashrc > ~/.bashrc.new && mv ~/.bashrc.new ~/.bashrc; }

"$HOME/projects/github/${setup_repository}/bootstrap.sh"

# Syncthing last, so its first scan sees the finished folder. The one device is
# the laptop, the one folder the setup repo, by its name; each step holds on a
# re-run (adding the folder again fails, so it's checked first). The laptop
# accepts this VM by hand; the generate line logs the VM's device ID.
syncthing generate --no-default-folder
systemctl --user enable --now syncthing.service
tries=0
until syncthing cli show system >/dev/null 2>&1; do
  tries=$((tries + 1))
  [ "$tries" -lt 60 ] || { echo 'Syncthing did not start: journalctl --user -u syncthing' >&2; exit 1; }
  sleep 1
done
syncthing cli config devices add --device-id ${syncthing_peer} --name laptop
syncthing cli config folders list | grep -qx '${folder}' \
  || syncthing cli config folders add --id ${folder} --label ${folder} --path "$repo"
syncthing cli config folders ${folder} devices add --device-id ${syncthing_peer}
