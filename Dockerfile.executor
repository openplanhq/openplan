FROM golang:1.25.14-alpine3.23 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/openplan-executor ./cmd/executor

# The guest root every sandbox boots from, read-only: tofu, git and CA
# certificates for the activities' bodies, and the executor binary they run
# as. Built apart, so nothing of the executor's own filesystem reaches a
# sandbox.
FROM alpine:3.21 AS guest
ARG OPENTOFU_VERSION=1.12.5
ARG TARGETARCH
RUN apk add --no-cache ca-certificates git \
    && wget -O "/tmp/tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz" \
        "https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz" \
    && wget -O "/tmp/tofu_${OPENTOFU_VERSION}_SHA256SUMS" \
        "https://github.com/opentofu/opentofu/releases/download/v${OPENTOFU_VERSION}/tofu_${OPENTOFU_VERSION}_SHA256SUMS" \
    && cd /tmp \
    && grep -F "  tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz" "tofu_${OPENTOFU_VERSION}_SHA256SUMS" | sha256sum -c - \
    && tar -xzf "tofu_${OPENTOFU_VERSION}_linux_${TARGETARCH}.tar.gz" -C /usr/local/bin tofu \
    && rm -f /tmp/tofu_*
COPY --from=build /out/openplan-executor /usr/local/bin/openplan-executor

# gVisor, pinned and checksummed. runsc refuses to start without its
# gvisor-bin/ sidecars beside it; the containerd shim isn't used.
FROM alpine:3.21 AS gvisor
ARG GVISOR_RELEASE=20261005.0
ARG TARGETARCH
RUN apk add --no-cache tar zstd \
    && arch="$(case "${TARGETARCH}" in amd64) echo x86_64 ;; arm64) echo aarch64 ;; *) exit 1 ;; esac)" \
    && url="https://storage.googleapis.com/gvisor/releases/release/${GVISOR_RELEASE}/${arch}" \
    && cd /tmp \
    && wget -q "${url}/gvisor.tar.zstd" "${url}/gvisor.tar.zstd.sha512" \
    && sha512sum -c gvisor.tar.zstd.sha512 \
    && mkdir /out \
    && tar --zstd -xf gvisor.tar.zstd -C /out \
    && rm /out/containerd-shim-runsc-v1

FROM alpine:3.21

RUN apk add --no-cache ca-certificates tini findutils nftables \
    # Same uid and gid as Dockerfile.api: the two share the artifacts volume
    # through the group openplan, and root joins it to delete applied plans.
    && addgroup -S -g 10001 openplan \
    && adduser -S -D -H -u 10001 -G openplan openplan \
    && addgroup root openplan \
    && mkdir -p /var/lib/openplan/artifacts /var/lib/openplan/runs /var/lib/openplan/sandboxes \
    && chown openplan:openplan /var/lib/openplan/artifacts \
    && chmod 2770 /var/lib/openplan/artifacts
COPY --from=gvisor /out/ /usr/local/bin/
COPY --from=guest / /opt/openplan/guest/
COPY --from=build /out/openplan-executor /usr/local/bin/openplan-executor

# Root, with what runsc needs to start sandboxes inside this container:
# SYS_ADMIN, SETUID, SETGID, SETFCAP and CHOWN, Docker's seccomp and AppArmor
# profiles off (docker-compose.yaml). Every activity's body runs in a sandbox
# of its own as an unprivileged user. tini is PID 1, so processes the
# executor leaves behind are reaped.
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/openplan-executor"]
